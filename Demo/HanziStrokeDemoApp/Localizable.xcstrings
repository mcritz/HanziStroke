{
  "sourceLanguage": "en",
  "strings": {
    "Hanzi Stroke": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "漢字筆順"
          }
        }
      }
    },
    "Look up": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查詢"
          }
        }
      }
    },
    "Type any character…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入任一個字…"
          }
        }
      }
    },
    "Show": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示"
          }
        }
      }
    },
    "Enter a Chinese character.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入一個漢字。"
          }
        }
      }
    },
    "Basics": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基本"
          }
        }
      }
    },
