    "Speed %@×": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "速度 %@×"
          }
        }
      }
    },
    "Loop": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複播放"
          }
        }
      }
    },
    "Highlight radical": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標示部首"
          }
        }
      }
    },
    "Practice grid": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "米字格"
          }
        }
      }
    },
    "Step by step": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分解步驟"
          }
        }
      }
    },
    "Can't connect": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線"
          }
        }
      }
    },
    "Stroke data for “%@” isn't on this device yet. Check your connection and try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部裝置上還沒有「%@」的筆畫資料。請檢查網路連線後再試一次。"
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再試一次"
          }
        }
      }
    },
    "No stroke data": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有筆畫資料"
          }
        }
      }
    },
    "The stroke data set doesn't include “%@”. Try a different character.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆畫資料中沒有「%@」。請試試其他字。"
          }
        }
      }
    },
    "Character data": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "字形資料"
          }
        }
      }
    },
    "Stroke data comes from hanzi-writer-data, which is based on Make Me a Hanzi and fonts by Arphic Technology. It is used under the Arphic Public License.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆畫資料來自 hanzi-writer-data，以 Make Me a Hanzi 及文鼎科技的字型為基礎，依「文鼎公眾授權書」（Arphic Public License）使用。"
          }
        }
      }
    },
    "hanzi-writer-data on GitHub": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 上的 hanzi-writer-data"
          }
        }
      }
    },
    "Make Me a Hanzi on GitHub": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 上的 Make Me a Hanzi"
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱私"
          }
        }
      }
    },
    "Arphic Public License": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文鼎公眾授權書"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "%lld strokes": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld stroke"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld strokes"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 畫"
                }
              }
            }
          }
        }
      }
    },
    "About 3,900 common characters (roughly a sixth-grade reading level, in Traditional and Simplified forms) are built into the app and work offline. When you look up any other character for the first time, the app downloads its stroke data from the jsDelivr CDN, which receives the character and your IP address. After that, the data is stored on this device.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 內建約 3,900 個常用字（約國小六年級的識字量，含繁體與簡體），不需網路即可使用。第一次查詢其他字時，App 會從 jsDelivr CDN 下載筆畫資料，jsDelivr 會收到這個字和你的 IP 位址。之後資料會儲存在這部裝置上。"
          }
        }
      }
    }
  },
  "version": "1.0"
}