          }
        }
      }
    },
    "Traditional": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繁體"
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "致謝"
          }
        }
      }
    },
    "Loading %@…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在載入「%@」…"
          }
        }
      }
    },
    "Reduce Motion is on, so the finished character is shown. The steps below show the order.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟「減少動態效果」，因此直接顯示完成的字。筆順請見下方的分解步驟。"
          }
        }
      }
    },
    "Replay": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重播"
          }
        }
      }
    },
    "or tap the character": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或點一下字"
          }
        }
      }
    },
    "Speed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "速度"
          }
        }
      }
    },
